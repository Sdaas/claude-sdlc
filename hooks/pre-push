#!/usr/bin/env bash
#
# pre-push hook — block the push if the test suite fails.
# Installed by ./install-hooks.sh (symlinked into .git/hooks/pre-push).

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "pre-push: running ./test.sh ..."
if ! "$REPO_ROOT/test.sh"; then
	echo "pre-push: tests failed — push aborted. Fix tests or use 'git push --no-verify' to override." >&2
	exit 1
fi
echo "pre-push: tests passed — proceeding."
exit 0
