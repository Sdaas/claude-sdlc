"""API tests for {{NAME}} via Starlette's TestClient.

No external boundary is crossed (the app is exercised in-process), so these run
in the default fast lane. A test against a *real* downstream (DB, an upstream
service) would carry `@pytest.mark.integration` and live in the opt-in lane
(see the profile-python `## 3. Testing pyramid`).

The tests are hermetic: rather than depend on an ambient env var, they inject a
known signing secret through FastAPI's `dependency_overrides` — the idiomatic way
to test a `Depends`-based app.
"""

import time

import jwt
from fastapi.testclient import TestClient

from {{PKG}}.app import app
from {{PKG}}.settings import Settings, get_settings

TEST_SECRET = "test-secret-key-at-least-32-bytes-long!!"


def _test_settings() -> Settings:
    return Settings(jwt_secret=TEST_SECRET, jwt_algorithm="HS256")


# Every Depends(get_settings) in the app now sees the test settings.
app.dependency_overrides[get_settings] = _test_settings
client = TestClient(app)


def _token(**overrides: object) -> str:
    """Mint a bearer token signed with the same secret the app verifies against."""
    payload = {"sub": "alice", "scopes": ["read"], "exp": time.time() + 60}
    payload.update(overrides)
    return jwt.encode(payload, TEST_SECRET, algorithm="HS256")


def test_healthz_ok():
    r = client.get("/healthz")
    assert r.status_code == 200
    assert r.json() == {"status": "ok"}


def test_me_requires_auth():
    # No Authorization header → the Depends(require_principal) gate returns 401.
    assert client.get("/me").status_code == 401


def test_me_rejects_garbage_token():
    r = client.get("/me", headers={"Authorization": "Bearer not.a.jwt"})
    assert r.status_code == 401


def test_me_accepts_valid_token():
    r = client.get("/me", headers={"Authorization": f"Bearer {_token()}"})
    assert r.status_code == 200
    assert r.json()["subject"] == "alice"
